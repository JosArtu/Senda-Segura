# Copy to backend/.env and fill in. Never commit backend/.env.
# The Things Network (TTN) cluster region: nam1, eu1, or au1.
TTN_REGION=nam1
# TTN application ID that owns the end devices.
TTN_APP_ID=
# TTN API key with permission to write downlink application traffic.
TTN_API_KEY=
# Optional. Listening port (default 3000).
PORT=3000
# Optional. Comma-separated browser origins allowed to call the API (e.g. the Expo web preview).
# Leave empty for native-only use.
CORS_ORIGINS=
